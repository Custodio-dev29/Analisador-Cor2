{
  "name": "analisador-de-cores",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Analisador de cores PWA: amostragem em resolucao real com alpha, comparacao CIEDE2000 e persistencia local.",
  "scripts": {
    "dev": "npx --yes serve . --listen 8080",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-refs.js && node scripts/smoke-server.js",
    "build": "node scripts/build.js",
    "postbuild": "node scripts/smoke-server.js dist",
    "preview": "npx --yes serve dist --listen 8080",
    "check": "npm run lint && npm run test && npm run verify"
  },
  "devDependencies": {
    "eslint": "^9.36.0",
    "fake-indexeddb": "^6.0.1",
    "globals": "^15.15.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
